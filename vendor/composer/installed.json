                    "link-template": "https://github.com/Automattic/jetpack-status/compare/v${old}...v${new}"
                },
                "branch-alias": {
                    "dev-trunk": "6.1.x-dev"
                },
                "dependencies": {
                    "test-only": [
                        "packages/connection",
                        "packages/plans"
                    ]
                }
            },
